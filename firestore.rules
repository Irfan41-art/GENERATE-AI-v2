rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidModule(data) {
      return data.userId == request.auth.uid
        && data.subject is string && data.subject.size() <= 100
        && data.className is string && data.className.size() <= 20
        && data.phase is string && data.phase.size() <= 10
        && data.semester is string && data.semester.size() <= 20
        && data.topic is string && data.topic.size() <= 255
        && data.timeAllocation is string && data.timeAllocation.size() <= 100
        && (data.cp == null || (data.cp is string && data.cp.size() <= 2000))
        && data.content is map
        && data.createdAt == request.time;
    }

    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && (data.updatedAt == null || data.updatedAt == request.time);
    }

    // Rules for Modules
    match /modules/{moduleId} {
      allow create: if isSignedIn() && isValidId(moduleId) && isValidModule(incoming());
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Rules for Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }
  }
}
